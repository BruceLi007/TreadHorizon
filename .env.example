# 复制本文件为 .env.local 后填写真实值（.env.local 已被 .gitignore 忽略，不会进版本库）
#   Windows:      copy .env.example .env.local
#   macOS/Linux:  cp .env.example .env.local
#
# 说明：不建 .env.local 也能启动 —— 本地模式（默认）下第一次打开应用时，
# 会先显示「配置天地图 Key」引导页，按提示粘贴 Key 即可（之后可在 设置 → 天地图 Key 修改）。

# ── 天地图 Key（32 位，浏览器端类型；免费申请 https://www.tianditu.gov.cn/ ）──
TDT_TK=

# ── 本地服务端口（默认 4000）──
PORT=4000

# ── 单文件上传上限（可选，默认 8，单位 GB）──
# 大疆 / 相机单段视频可能超过 2GB；旧版硬编码 2GB，超限会报 Payload Too Large 并留下半截文件。
MAX_UPLOAD_GB=8

# ── 数据与素材路径（可选，不填用默认值）──
# 应用数据目录（SQLite / 缩略图 / 备份），默认 ./data
# DATA_DIR=<应用数据目录>
# 生产模式素材库根目录（上传的原片会复制到这里），默认 ./.dev-media
# MEDIA_ROOT=<素材库目录>
# 开发模式下（npm run dev / node server/index.mjs --dev）的素材库根目录，默认 ./.dev-media
# MEDIA_ROOT_DEV=

# ── 多用户模式（可选；单人本地使用不需要）─────────────────────────────
# local（默认）= 单机本地模式：不需要登录、行为与历史版本一致；
# multi        = 云端多用户模式：启用账号 / 会话 / 邀请码，所有数据按用户隔离。
AUTH_MODE=local
# 首个管理员（AUTH_MODE=multi 且库里还没有用户时，服务启动会自动创建；密码不打印）。
# 也可以手动创建 / 重置：npm run init:admin -- <用户名> <密码> [--reset]
ADMIN_USERNAME=
ADMIN_PASSWORD=
# 会话有效期（天，默认 30；每次访问自动滚动续期）
# SESSION_DAYS=30
# HTTPS 云端部署时置 1：会话 Cookie 带 Secure（本地 http 调试不要开）
# COOKIE_SECURE=1
